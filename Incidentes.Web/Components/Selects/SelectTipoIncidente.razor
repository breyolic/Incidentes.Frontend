@using System.Linq.Expressions
@inject ITipoIncidenteService TipoIncidenteService

<MudSelect Value="Id"
           ValueChanged="OnIdChanged"
           Variant="Variant.Filled"
           Dense="true"
           FullWidth="true"
           Required="true"
           ShrinkLabel="true"
           T="int"
           For="@For">
    <MudSelectItem value="0" disabled>Seleccione el tipo de incidente</MudSelectItem>
    @if (TiposIncidente != null)
    {
        @foreach (var tipo in TiposIncidente)
        {
            <MudSelectItem Value="@tipo.Id">@tipo.Descripcion</MudSelectItem>
        }
    }
</MudSelect>

@code {
    private List<TipoIncidente>? TiposIncidente;
    [Parameter] public int Id { get; set; }
    [Parameter] public EventCallback<int> IdChanged { get; set; }
    [Parameter] public Expression<Func<int>> For { get; set; }

    protected override async Task OnInitializedAsync()
    {
        TiposIncidente = await TipoIncidenteService.GetTiposIncidenteAsync();
    }

    private async Task OnIdChanged(int value)
    {
        Id = value;
        await IdChanged.InvokeAsync(value);
    }
}
